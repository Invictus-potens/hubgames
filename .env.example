STEAM_API_KEY=
STEAM_DOMAIN=
SESSION_SECRET=
PORT=3422

# Opcional: chave da RAWG API (https://rawg.io/apidocs) para metadata rica
# (gênero, sinopse, nota crítica, screenshots). Sem ela, o endpoint de
# metadata retorna 501 e a funcionalidade fica desabilitada.
RAWG_API_KEY=

# Usado pelo docker-compose para configurar o container do Postgres
POSTGRES_PASSWORD=

# String de conexão usada pelo Prisma. Ao rodar via docker-compose, o
# docker-compose.yml já sobrescreve esta variável apontando para o serviço
# "postgres". Para rodar localmente sem Docker, troque o host para "localhost".
DATABASE_URL=postgresql://hubgames:troque-esta-senha@localhost:5432/hubgames
